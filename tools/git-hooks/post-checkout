#!/bin/sh
# Gives a new worktree its own worktree of every nested repository that the
# main checkout contains, at the same path and on a branch of the same name.
#
# Install once per clone, from the main checkout, with the other Genesis hooks:
#   sh tools/git-hooks/install.sh
#
# Git runs this hook after every checkout. Only `git worktree add` passes an
# all-zero previous commit, so ordinary branch switches exit immediately.
# Failures print a warning and never block the worktree.

previous=$1
branch_checkout=$3
[ "$branch_checkout" = 1 ] || exit 0
[ -n "$previous" ] || exit 0
case "$previous" in *[!0]*) exit 0 ;; esac

# `git worktree add` runs the hook inside the new worktree with GIT_DIR and
# GIT_WORK_TREE set. Read them, then clear them so `git -C <nested>` commands
# address the nested repositories.
worktree=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR

[ "$(basename "$common")" = .git ] || exit 0
main=$(dirname "$common")
[ "$main" = "$worktree" ] && exit 0

warn() {
  echo "post-checkout: $*" >&2
}

# Adds a worktree of `$source` at `$target`, matching the outer branch.
add_worktree() {
  source=$1
  target=$2
  if [ -z "$branch" ]; then
    git -C "$source" worktree add --quiet --detach "$target"
  elif git -C "$source" show-ref --verify --quiet "refs/heads/$branch"; then
    # A branch can be checked out in only one worktree; fall back to detached.
    git -C "$source" worktree add --quiet "$target" "$branch" 2>/dev/null ||
      git -C "$source" worktree add --quiet --detach "$target" "$branch"
  else
    git -C "$source" worktree add --quiet -b "$branch" "$target"
  fi
}

# Walks the untracked directories of the repository at `$1` (the main
# checkout's copy), and mirrors each nested repository under `$2`. The plain
# listing stops at the first untracked folder, so `collections/` hides an
# ignored `collections/applets/`; the ignored listing descends to it.
mirror_nested() {
  {
    git -C "$1" -c core.quotePath=false ls-files --others --directory
    git -C "$1" -c core.quotePath=false ls-files --others --ignored --exclude-standard --directory
  } | sort -u |
    while IFS= read -r path; do
      case "$path" in */) ;; *) continue ;; esac
      path=${path%/}
      source="$1/$path"
      target="$2/$path"
      [ -e "$source/.git" ] || continue
      [ -e "$target" ] && continue
      nested_common=$(git -C "$source" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || continue
      # Skip worktrees of the outer repository that live inside its checkout.
      [ "$nested_common" = "$common" ] && continue
      if add_worktree "$source" "$target"; then
        echo "post-checkout: added nested worktree $target" >&2
        mirror_nested "$source" "$target"
      else
        warn "could not add a worktree of $source at $target"
      fi
    done
}

mirror_nested "$main" "$worktree"
exit 0
