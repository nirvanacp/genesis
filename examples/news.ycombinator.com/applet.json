      "kind": "website"
    },
    {
      "id": "website-delete",
      "pattern": "/delete",
      "kind": "website"
    },
    {
      "id": "website-edit",
      "pattern": "/edit",
      "kind": "website"
    },
    {
      "id": "website-fave",
      "pattern": "/fave",
      "kind": "website"
    },
    {
      "id": "website-forgot",
      "pattern": "/forgot",
      "kind": "website"
    },
    {
      "id": "website-login",
      "pattern": "/login",
      "kind": "website"
    },
    {
      "id": "website-logout",
      "pattern": "/logout",
      "kind": "website"
    },
    {
      "id": "website-r",
      "pattern": "/r",
      "kind": "website"
    },
    {
      "id": "website-reply",
      "pattern": "/reply",
      "kind": "website"
    },
    {
      "id": "website-vote",
      "pattern": "/vote",
      "kind": "website"
    },
    {
      "id": "website-x",
      "pattern": "/x",
      "kind": "website"
    },
    {
      "id": "website-hide",
      "pattern": "/hide",
      "kind": "website"
    }
  ],
  "capabilities": {
    "services": [
      {
        "id": "bookmarks",
        "config": "backend/service.json"
      }
    ]
  },
  "shell": {
    "accent": "#ff6600"
  }
}
