{
  "schemaVersion": 6,
  "id": "hn-bookmarks",
  "name": "Hacker News",
  "origins": [
    "https://news.ycombinator.com"
  ],
  "foreground": {
    "entry": "src/main.tsx",
    "screens": [
      "feed",
      "item",
      "user"
    ]
  },
  "adapter": "src/adapter.ts",
  "contexts": [
    {
      "id": "primary",
      "startUrl": "https://news.ycombinator.com/"
    }
  ],
  "routes": [
    {
      "id": "home",
      "pattern": "/",
      "page": "feed",
      "screen": "feed",
      "context": "primary"
    },
    {
      "id": "news",
      "pattern": "/news",
      "page": "feed",
      "screen": "feed",
      "context": "primary"
    },
    {
      "id": "item",
      "pattern": "/item",
      "query": [
        "id"
      ],
      "page": "item",
      "screen": "item",
      "context": "primary"
    },
    {
      "id": "user",
      "pattern": "/user",
      "query": [
        "id"
      ],
      "page": "user",
      "screen": "user",
      "context": "primary"
    }
  ],
  "capabilities": {
    "services": [
      {
        "id": "bookmarks",
        "config": "backend/service.json"
      }
    ]
  },
  "shell": {
    "accent": "#ff6600"
  }
}
