{
  "schemaVersion": 6,
  "id": "hn-bookmarks",
  "name": "Hacker News",
  "origins": [
    "https://news.ycombinator.com"
  ],
  "foreground": {
    "entry": "src/main.tsx",
    "screens": [
      "feed",
      "item",
      "user",
      "info",
      "search",
      "post",
      "saved",
      "categories",
      "save",
      "me"
    ]
  },
  "adapter": "src/adapter.ts",
  "contexts": [
    {
      "id": "primary",
      "startUrl": "https://news.ycombinator.com/"
    },
    {
      "id": "post",
      "startUrl": "https://news.ycombinator.com/submit"
    },
    {
      "id": "me",
      "startUrl": "https://news.ycombinator.com/news?account=1"
    }
  ],
  "routes": [
    {
      "id": "account",
      "pattern": "/news",
      "query": [
        "account"
      ],
      "page": "account",
      "screen": "me",
      "context": "me"
    },
    {
      "id": "home",
      "pattern": "/",
      "page": "feed",
      "screen": "feed",
      "context": "primary"
    },
    {
      "id": "news",
      "pattern": "/news",
      "page": "feed",
      "screen": "feed",
      "context": "primary"
    },
    {
      "id": "newest",
      "pattern": "/newest",
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "front",
      "pattern": "/front",
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "newcomments",
      "pattern": "/newcomments",
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "ask",
      "pattern": "/ask",
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "show",
      "pattern": "/show",
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "shownew",
      "pattern": "/shownew",
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "asknew",
      "pattern": "/asknew",
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "jobs",
      "pattern": "/jobs",
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "best",
      "pattern": "/best",
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "active",
      "pattern": "/active",
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "from",
      "pattern": "/from",
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "submitted",
      "pattern": "/submitted",
      "query": [
        "id"
      ],
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "threads",
      "pattern": "/threads",
      "query": [
        "id"
      ],
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "favorites",
      "pattern": "/favorites",
      "query": [
        "id"
      ],
      "page": "feed",
      "screen": "feed"
    },
    {
      "id": "hidden",
      "pattern": "/hidden",
      "query": [
        "id"
      ],
      "page": "private-feed",
      "screen": "feed"
    },
    {
      "id": "upvoted",
      "pattern": "/upvoted",
      "query": [
        "id"
      ],
      "page": "private-feed",
      "screen": "feed"
    },
    {
      "id": "item",
      "pattern": "/item",
      "query": [
        "id"
      ],
      "page": "item",
      "screen": "item"
    },
    {
      "id": "user",
      "pattern": "/user",
      "query": [
        "id"
      ],
      "page": "user",
      "screen": "user"
