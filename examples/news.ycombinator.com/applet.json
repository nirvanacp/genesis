{
  "schemaVersion": 5,
  "id": "hn-bookmarks",
  "name": "Hacker News",
  "origins": [
    "https://news.ycombinator.com"
  ],
  "foreground": {
    "entry": "src/main.tsx",
    "screens": [
      "feed",
      "item",
      "user",
      "info",
      "search",
      "post",
      "saved",
      "save",
      "me",
      "unsupported"
    ]
  },
  "sources": [
    {
      "id": "primary",
      "startUrl": "https://news.ycombinator.com/",
      "adapter": "src/sources/primary.ts"
    },
    {
      "id": "post",
      "startUrl": "https://news.ycombinator.com/submit",
      "adapter": "src/sources/post.ts"
    },
    {
      "id": "me",
      "startUrl": "https://news.ycombinator.com/news?account=1",
      "adapter": "src/sources/me.ts"
    }
  ],
  "routes": [
    {
      "id": "account",
      "pattern": "/news",
      "query": [
        "account"
      ],
      "kind": "adapted",
      "source": "me",
      "screen": "me",
      "requiresSignIn": true
    },
    {
      "id": "home",
      "pattern": "/",
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "news",
      "pattern": "/news",
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "newest",
      "pattern": "/newest",
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "front",
      "pattern": "/front",
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "newcomments",
      "pattern": "/newcomments",
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "ask",
      "pattern": "/ask",
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "show",
      "pattern": "/show",
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "shownew",
      "pattern": "/shownew",
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "asknew",
      "pattern": "/asknew",
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "jobs",
      "pattern": "/jobs",
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "best",
      "pattern": "/best",
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "active",
      "pattern": "/active",
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "from",
      "pattern": "/from",
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "submitted",
      "pattern": "/submitted",
      "query": [
        "id"
      ],
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "threads",
      "pattern": "/threads",
      "query": [
        "id"
      ],
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "favorites",
      "pattern": "/favorites",
      "query": [
        "id"
      ],
      "kind": "adapted",
      "source": "primary",
      "screen": "feed"
    },
    {
      "id": "hidden",
      "pattern": "/hidden",
      "query": [
        "id"
      ],
      "kind": "adapted",
      "source": "primary",
      "screen": "feed",
      "requiresSignIn": true
    },
    {
      "id": "upvoted",
