    },
    {
      "id": "faq",
      "pattern": "/newsfaq.html",
      "kind": "adapted",
      "source": "primary",
      "screen": "info"
    },
    {
      "id": "guidelines",
      "pattern": "/newsguidelines.html",
      "kind": "adapted",
      "source": "primary",
      "screen": "info"
    },
    {
      "id": "lists",
      "pattern": "/lists",
      "kind": "adapted",
