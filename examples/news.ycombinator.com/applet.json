    },
    {
      "id": "leaders",
      "pattern": "/leaders",
      "page": "info",
      "screen": "info"
    },
    {
      "id": "submit",
      "pattern": "/submit",
      "page": "submit",
      "screen": "post",
      "context": "post"
    },
    {
      "id": "submit-result",
      "pattern": "/r",
      "page": "submit",
      "screen": "post"
    }
  ],
  "capabilities": {
    "services": [
      {
        "id": "bookmarks",
        "config": "backend/service.json"
      }
    ]
  },
  "shell": {
    "accent": "#ff6600"
  }
