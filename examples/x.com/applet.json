{
  "schemaVersion": 6,
  "id": "x-bookmarks",
  "name": "X",
  "origins": [
    "https://x.com"
  ],
  "foreground": {
    "entry": "src/main.tsx",
    "screens": [
      "home",
      "explore",
      "notifications",
      "saved",
      "post",
      "profile",
      "media",
      "account",
      "categories",
      "save",
      "manage"
    ]
  },
  "adapter": "src/adapter.ts",
  "contexts": [
    {
      "id": "primary",
      "startUrl": "https://x.com/home"
    },
    {
      "id": "explore",
      "startUrl": "https://x.com/explore"
    },
    {
      "id": "account",
      "startUrl": "https://x.com/settings/account"
    }
  ],
  "routes": [
    {
      "id": "home",
      "pattern": "/home",
      "page": "timeline",
      "screen": "home",
      "context": "primary"
    },
    {
      "id": "notifications",
      "pattern": "/notifications",
      "page": "timeline",
      "screen": "notifications",
      "context": "primary"
    },
    {
      "id": "bookmarks",
      "pattern": "/i/history",
      "page": "timeline",
      "screen": "saved",
      "context": "primary"
    },
    {
      "id": "own-likes",
      "pattern": "/i/history/likes",
      "page": "timeline",
      "screen": "saved",
      "context": "primary"
    },
    {
      "id": "bookmarks-alias",
      "pattern": "/i/bookmarks",
      "page": "timeline",
      "screen": "saved",
      "context": "primary"
    },
    {
      "id": "explore",
      "pattern": "/explore/*",
      "page": "explore",
      "screen": "explore",
      "context": "explore"
    },
    {
      "id": "search",
      "pattern": "/search",
      "query": [
        "q"
      ],
      "page": "explore",
      "screen": "explore",
      "context": "explore"
    },
    {
      "id": "hashtag",
      "pattern": "/hashtag/:tag",
      "page": "explore",
      "screen": "explore",
      "context": "explore"
    },
    {
      "id": "account",
      "pattern": "/settings/account",
      "page": "account",
      "screen": "account",
      "context": "account"
    },
    {
      "id": "photo",
      "pattern": "/:handle/status/:id/photo/:index",
      "page": "media",
      "screen": "media"
    },
    {
      "id": "post",
      "pattern": "/:handle/status/:id",
      "page": "post",
      "screen": "post"
    },
    {
      "id": "likes",
      "pattern": "/:handle/likes",
      "page": "timeline",
      "screen": "saved"
    },
    {
      "id": "replies",
      "pattern": "/:handle/with_replies",
      "page": "profile",
      "screen": "profile"
    },
    {
      "id": "profile-media",
      "pattern": "/:handle/media",
      "page": "profile",
      "screen": "profile"
    },
    {
      "id": "profile",
      "pattern": "/:handle",
      "page": "profile",
      "screen": "profile"
    }
  ],
  "capabilities": {
    "storage": true,
    "services": [
      {
        "id": "bookmarks",
        "config": "backend/service.json"
      }
    ]
  },
  "shell": {
    "accent": "#1d9bf0"
  }
}
