{
  "schemaVersion": 5,
  "id": "x-bookmarks",
  "name": "X",
  "origins": [
    "https://x.com"
  ],
  "foreground": {
    "entry": "src/main.tsx",
    "screens": [
      "home",
      "explore",
      "notifications",
      "saved",
      "post",
      "profile",
      "media",
      "account",
      "categories",
      "save",
      "manage",
      "unsupported"
    ]
  },
  "sources": [
    {
      "id": "primary",
      "startUrl": "https://x.com/home",
      "adapter": "src/sources/primary.ts"
    },
    {
      "id": "explore",
      "startUrl": "https://x.com/explore",
      "adapter": "src/sources/explore.ts"
    },
    {
      "id": "account",
      "startUrl": "https://x.com/settings/account",
      "adapter": "src/sources/account.ts"
    }
  ],
  "routes": [
    {
      "id": "home",
      "pattern": "/home",
      "kind": "adapted",
      "source": "primary",
      "screen": "home",
      "requiresSignIn": true
    },
    {
      "id": "notifications",
      "pattern": "/notifications",
      "kind": "adapted",
      "source": "primary",
      "screen": "notifications",
      "requiresSignIn": true
    },
    {
      "id": "bookmarks",
      "pattern": "/i/history",
      "kind": "adapted",
      "source": "primary",
      "screen": "saved",
      "requiresSignIn": true
    },
    {
      "id": "own-likes",
      "pattern": "/i/history/likes",
      "kind": "adapted",
      "source": "primary",
      "screen": "saved",
      "requiresSignIn": true
    },
    {
      "id": "bookmarks-alias",
      "pattern": "/i/bookmarks",
      "kind": "adapted",
      "source": "primary",
      "screen": "saved",
      "requiresSignIn": true
    },
    {
      "id": "explore",
      "pattern": "/explore/*",
      "kind": "adapted",
      "source": "explore",
      "screen": "explore"
    },
    {
      "id": "search",
      "pattern": "/search",
      "query": [
        "q"
      ],
      "kind": "adapted",
      "source": "explore",
      "screen": "explore"
    },
    {
      "id": "hashtag",
      "pattern": "/hashtag/:tag",
      "kind": "adapted",
      "source": "explore",
      "screen": "explore"
    },
    {
      "id": "account",
      "pattern": "/settings/account",
      "kind": "adapted",
      "source": "account",
      "screen": "account",
      "requiresSignIn": true
    },
    {
      "id": "root",
      "pattern": "/",
      "kind": "website"
    },
    {
      "id": "login",
      "pattern": "/login",
      "kind": "website"
    },
    {
      "id": "logout",
      "pattern": "/logout",
      "kind": "website"
    },
    {
      "id": "flow",
      "pattern": "/i/flow/*",
      "kind": "website"
    },
    {
      "id": "compose",
      "pattern": "/compose/*",
      "kind": "website"
    },
    {
      "id": "settings",
      "pattern": "/settings/*",
      "kind": "website"
    },
    {
      "id": "account-pages",
      "pattern": "/account/*",
      "kind": "website"
    },
    {
      "id": "messages",
      "pattern": "/messages/*",
      "kind": "website"
    },
    {
      "id": "internal",
      "pattern": "/i/*",
      "kind": "website"
    },
    {
      "id": "tos",
      "pattern": "/tos",
      "kind": "website"
    },
    {
      "id": "privacy",
      "pattern": "/privacy",
      "kind": "website"
    },
    {
      "id": "about",
      "pattern": "/about",
      "kind": "website"
    },
    {
      "id": "download",
      "pattern": "/download",
      "kind": "website"
    },
    {
      "id": "photo",
      "pattern": "/:handle/status/:id/photo/:index",
      "kind": "adapted",
      "source": "primary",
      "screen": "media"
    },
    {
      "id": "post-pages",
      "pattern": "/:handle/status/:id/*",
      "kind": "website"
    },
    {
      "id": "post",
      "pattern": "/:handle/status/:id",
      "kind": "adapted",
      "source": "primary",
      "screen": "post"
    },
    {
      "id": "following",
      "pattern": "/:handle/following",
      "kind": "website"
    },
    {
      "id": "followers",
      "pattern": "/:handle/followers",
      "kind": "website"
    },
    {
      "id": "verified-followers",
      "pattern": "/:handle/verified_followers",
      "kind": "website"
    },
    {
      "id": "avatar-photo",
      "pattern": "/:handle/photo",
      "kind": "website"
    },
    {
      "id": "header-photo",
      "pattern": "/:handle/header_photo",
      "kind": "website"
    },
    {
      "id": "likes",
      "pattern": "/:handle/likes",
      "kind": "adapted",
      "source": "primary",
      "screen": "saved",
      "requiresSignIn": true
    },
    {
      "id": "replies",
      "pattern": "/:handle/with_replies",
      "kind": "adapted",
      "source": "primary",
      "screen": "profile"
    },
    {
      "id": "profile-media",
      "pattern": "/:handle/media",
      "kind": "adapted",
      "source": "primary",
      "screen": "profile"
    },
    {
      "id": "profile",
      "pattern": "/:handle",
      "kind": "adapted",
      "source": "primary",
      "screen": "profile"
    }
  ],
  "capabilities": {
    "storage": true,
    "services": [
      {
        "id": "bookmarks",
        "config": "backend/service.json"
      }
    ]
  },
  "shell": {
    "accent": "#1d9bf0"
  }
}
