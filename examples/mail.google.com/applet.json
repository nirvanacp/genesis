{
  "schemaVersion": 6,
  "id": "gmail-only",
  "name": "Gmail Only",
  "origins": [
    "https://mail.google.com"
  ],
  "foreground": {
    "entry": "src/main.tsx",
    "screens": [
      "mail",
      "todo",
      "item",
      "add",
      "bulk",
      "search",
      "settings",
      "accounts",
      "account-setup",
      "snoozed",
      "menu"
    ]
  },
  "adapter": "src/adapter.ts",
  "contexts": [
    {
      "id": "primary",
      "startUrl": "https://mail.google.com/mail/u/0/"
    }
  ],
  "routes": [
    {
      "id": "mail",
      "pattern": "/mail/*",
      "page": "mail",
      "screen": "mail",
      "context": "primary"
    },
    {
      "id": "root",
      "pattern": "/",
      "page": "mail",
      "screen": "mail",
      "context": "primary"
    }
  ],
  "capabilities": {
    "storage": true
  },
  "shell": {
    "accent": "#2347d9"
  }
}
