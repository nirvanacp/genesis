{
  "name": "genesis",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/sdk",
    "packages/applet-tools",
    "examples/x.com",
    "examples/news.ycombinator.com"
  ],
  "engines": {
    "node": "24.15.0",
    "npm": "11.14.1"
  },
  "packageManager": "npm@11.14.1",
  "scripts": {
    "typecheck": "npm run build -w packages/core && node packages/sdk/build.mjs && npm run typecheck --workspaces",
    "check:packages": "node tools/check-packages.mjs",
    "build": "node tools/build.mjs --stage all --variant debug"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "esbuild": "0.28.2"
  }
}
