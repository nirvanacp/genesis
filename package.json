{
  "name": "genesis",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "let/packages/*",
    "applets/*"
  ],
  "engines": {
    "node": "24.15.0",
    "npm": "11.14.1"
  },
  "packageManager": "npm@11.14.1",
  "scripts": {
    "typecheck": "npm run build -w let/packages/core && node let/packages/sdk/build.mjs && npm run typecheck --workspaces",
    "check:packages": "node tools/check-packages.mjs",
    "workspace": "node tools/workspace.mjs",
    "build": "node tools/build.mjs --stage all --variant debug"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "esbuild": "0.28.2"
  }
}
