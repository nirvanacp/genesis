{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Genesis applet manifest schema 1",
  "description": "Structural schema. The Genesis semantic validator also checks exact HTTPS origins, references, contained files, and byte limits.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "dataSchemaVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "startUrl": {
            "type": "string",
            "minLength": 1
          },
          "origins": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "entry": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/)[^\\u0000]+$"
          },
          "homePaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "customizedPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "navigationRules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "pathPrefix": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "const": "block"
                },
                "fallbackUrl": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "pathPrefix",
                "action",
                "fallbackUrl"
              ]
            }
          }
        },
        "required": [
          "id",
          "startUrl",
          "origins",
          "entry"
        ]
      },
      "minItems": 1
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "entry": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/)[^\\u0000]+$"
          }
        },
        "required": [
          "id",
          "entry"
        ]
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "pageId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "required": [
          "id",
          "label",
          "pageId"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "dom",
          "navigation-policy",
          "storage",
          "services"
        ]
      },
      "uniqueItems": true
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "uniqueItems": true
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 79
        },
        "brandAsset": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/)[^\\u0000]+$"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "sourceId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "pageId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "icon": {
                "enum": [
                  "home",
                  "search",
                  "post",
                  "bookmark",
                  "person"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "sourceId"
            ]
          },
          "minItems": 1,
          "maxItems": 5
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "sourceId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "required": [
              "label",
              "url"
            ]
          }
        }
      },
      "required": [
        "title",
        "brandAsset",
        "sections"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "dataSchemaVersion",
    "sources",
    "pages",
    "actions",
    "capabilities"
  ]
}
