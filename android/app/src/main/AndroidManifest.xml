<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Websites may ask for these only while shown, after the user allows them (Shell.askSite). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Applets the user turned notifications on for (Notifications). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager declares it for foreground work, which Genesis never starts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".GenesisApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NirvanaGenesis">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|uiMode|fontScale"
            android:launchMode="singleTask"
            android:exported="true"
            android:theme="@style/Theme.NirvanaGenesis"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Applet bundles shared from other apps, or opened by their .bundle.json name. Genesis does not
                 offer to open every JSON file. The host reviews every bundle before installing. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/json" />
            </intent-filter>
            <!-- Website links shared from other apps open in the applet that declares the site. Genesis
                 does not register as a browser for VIEW http(s) links. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.bundle\\.json" />
                <data android:pathPattern=".*\\..*\\.bundle\\.json" />
            </intent-filter>
            <!-- Recent applets as direct-share targets for website links. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- One window per applet, each in its own document task, so every applet has its own Recents
             card. Its intent's data names the applet (genesis-applet:<id>); intoExisting reuses that task. -->
        <activity
            android:name=".AppletActivity"
            android:autoRemoveFromRecents="false"
            android:configChanges="orientation|screenSize|uiMode|fontScale"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:launchMode="standard"
            android:persistableMode="persistRootOnly"
            android:theme="@style/Theme.NirvanaGenesis.Applet"
            android:windowSoftInputMode="adjustResize" />
        <!-- Shortcuts and drawer entries start this invisible activity, which brings forward the
             applet's window without the launcher's CLEAR_TASK ending it. -->
        <activity
            android:name=".AppletEntryActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
    </application>

</manifest>
