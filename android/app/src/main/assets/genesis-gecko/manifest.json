{
  "manifest_version": 2,
  "name": "Genesis",
  "version": "1.0",
  "description": "Gives a Genesis page agent the bridge it has in WebView.",
  "browser_specific_settings": { "gecko": { "id": "gecko@genesis.nirvana.app" } },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": false }
  ],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"]
}
